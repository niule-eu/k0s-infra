import "pkl:reflect"

import "@k8s/api/core/v1/Namespace.pkl"
import "@k8s/api/core/v1/Service.pkl"
import "@k8s-gateway/v1beta1/ReferenceGrant.pkl"
import "@k8s/K8sResource.pkl"
import "./network-infra-ams23-meta.pkl" as niams23meta

hidden fixed namespace = niams23meta.namespace
hidden helm_chart_name = "coredns"
hidden helm_chart_url = "oci://ghcr.io/coredns/charts/coredns"
hidden helm_chart_version = "v1.45.2"

resources: Listing = new {
  new ReferenceGrant {
    metadata {
      name = "coredns-kube-system"
      namespace = module.namespace
    }
    spec {
      from {
        new {
          group = "gateway.networking.k8s.io"
          kind = "UDPRoute"
          namespace = "kube-system"
        }
      }
      to {
        new {
          group = ""
          kind = "Service"
        }
      }
    }
  }
  new {
    apiVersion = "source.toolkit.fluxcd.io/v1"
    kind = "OCIRepository"
    metadata {
      name = helm_chart_name
      namespace = "flux-system"
    }
    spec {
      interval = "5m"
      url = helm_chart_url
      ref {
        semver = helm_chart_version
      }
    }
  }
  new {
    apiVersion = "helm.toolkit.fluxcd.io/v2"
    kind = "HelmRelease"
    metadata {
      name = helm_chart_name
      namespace = module.namespace
    }
    spec {
      interval = "10m"
      chartRef {
        kind = "OCIRepository"
        name = helm_chart_name
        namespace = "flux-system"
      }
      values {
        isClusterService = false
        servers {
          // TODO: Add server config for infra.ams23.niule.xyz, use env variables injected into coredns pod about authoritative dns service, see: https://kubernetes.io/docs/concepts/services-networking/service/#environment-variables 
          new {
            zones {
              new { zone = "."; use_tcp = true }
            }
            port = 1053
            plugins {
              new { name = "errors" }
              new { name = "health"; configBlock = "lameduck 10s" }
              new { name = "ready" }
              new {
                name = "forward"
                parameters = ". tls://1.0.0.1 tls://1.0.0.2"
                configBlock = "tls_servername security.cloudflare-dns.com"
              }
              new { name = "log" }
              new { name = "loop" }
              new { name = "cache"; parameters = 60 }
            }
          }
        }
      }
    }
  }
}

output {
  value = resources
  renderer = (K8sResource.output.renderer as YamlRenderer) {
    isStream = true
  }
  files {
    ["coredns.yaml"] {
      value = resources
      renderer = (K8sResource.output.renderer as YamlRenderer) {
        isStream = true
      }
    }
  }
}
