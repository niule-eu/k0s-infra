import "pkl:reflect"

import "@k8s-gateway/v1beta1/ReferenceGrant.pkl"
import "@k8s/api/apps/v1/Deployment.pkl"
import "@k8s/api/core/v1/Namespace.pkl"
import "@k8s/api/core/v1/Service.pkl"
import "@k8s/K8sResource.pkl"

import "../../infrastructure/configs/cnpg.pkl"
import "./network-infra-ams23-meta.pkl" as niams23meta

hidden kea_postgres_user = "kea"
hidden kea_postgres_db = "kea"
hidden kea_postgres_password = "kea"
hidden kea_dhcpv4_image = "ghcr.io/niule-eu/homelab/kea-dhcpv4-slim:3.1.5"

resources: Listing = new {
  new {
    apiVersion = "postgresql.cnpg.io/v1"
    kind = "Cluster"
    metadata {
      name = "kea-postgres"
      namespace = niams23meta.namespace
    }
    spec {
      instances = 1
      imageCatalogRef {
        apiGroup = "postgresql.cnpg.io"
        kind = "ClusterImageCatalog"
        name = cnpg.image_cataloge_name
        major = 18
      }
      storage { size = "1Gi" }
      bootstrap {
        initdb {
          database = kea_postgres_db
          owner = kea_postgres_user
        }
      }
    }
  }
  new Deployment {
    metadata {
      name = "kea-dhcpv4"
      namespace = niams23meta.namespace
    }
    spec {
      replicas = 1
      strategy {
        type = "Recreate"
      }
      selector {
        matchLabels {
          ["app"] = "kea-dhcpv4"
        }
      }
      template {
        metadata {
          labels {
              ["app"] = "kea-dhcpv4"
            }
          annotations {
            ["k8s.v1.cni.cncf.io/networks"] = "kube-system/kea-macvlan-13"
          }
        }
        spec {
          containers {
            // new {
            //   name = "kea-dhcpv4"
            //   image = kea_dhcpv4_image
            //   securityContext {
            //     capabilities {
            //       add {
            //         "CAP_NET_ADMIN"
            //         "CAP_NET_RAW"
            //         "CAP_NET_BIND_SERVICE"
            //       }
            //     }
            //   }
            // }
            new {
              name = "idle"
              image = "nginx:alpine"
              command {
                "sleep"
                "infinity"
              }
            }
          }
        }
      }
    }
  }
}

output {
  value = resources
  renderer = (K8sResource.output.renderer as YamlRenderer) {
    isStream = true
  }
  files {
    ["dhcp.yaml"] {
      value = resources
      renderer = (K8sResource.output.renderer as YamlRenderer) {
        isStream = true
      }
    }
  }
}
