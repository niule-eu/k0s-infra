import "@k8s-gateway/v1/Gateway.pkl"
import "@k8s-gateway/v1/GatewayClass.pkl"
import "@k8s/K8sResource.pkl"

resources: Listing = new {
  new GatewayClass {
    metadata {
      name = "eg"
    }
    spec {
      controllerName = "gateway.envoyproxy.io/gatewayclass-controller"
    }
  }
  new Gateway {
    metadata {
      name = "dns-gateway"
      namespace = "kube-system"
    }
    spec {
      gatewayClassName = "eg"
      infrastructure {
        parametersRef {
          group = "gateway.envoyproxy.io"
          kind = "EnvoyProxy"
          name = "dns-nodeport"
        }
      }
      listeners {
        dnsListener("TCP")
        dnsListener("UDP")
      }
    }
  }
  new {
    apiVersion = "gateway.envoyproxy.io/v1alpha1"
    kind = "EnvoyProxy"
    metadata {
      name = "dns-nodeport"
      namespace = "kube-system"
    }
    spec {
      provider {
        type = "Kubernetes"
        kubernetes {
          envoyService {
            type = "NodePort"
            patch {
              type = "StrategicMerge"
              value {
                spec {
                  ports {
                    new {
                      name = "dns_tcp"
                      port = 53
                      protocol = "TCP"
                      nodePort = 53
                    }
                    new {
                      name = "dns_udp"
                      port = 53
                      protocol = "UDP"
                      nodePort = 53
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

local function dnsListener(proto: "TCP" | "UDP") = new Gateway.Listener {
  port = 53
  protocol = proto
  name = "dns-\(proto.toLowerCase())"
  allowedRoutes {
    kinds {
      new {
        kind = "\(proto)Route"
      }
    }
  }
}

output {
  value = resources
  renderer = (K8sResource.output.renderer as YamlRenderer) {
    isStream = true
  }
  files {
    ["envoy-gateway.yaml"] {
      value = resources
      renderer = (K8sResource.output.renderer as YamlRenderer) {
        isStream = true
      }
    }
  }
}
