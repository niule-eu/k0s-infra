import "@k8s/api/core/v1/Namespace.pkl"
import "@k8s/K8sResource.pkl"

hidden namespace = "local-path-provisioner"
hidden helm_chart_name = "local-path-provisioner"
hidden helm_chart_url = "oci://dp.apps.rancher.io/charts/local-path-provisioner"
hidden helm_chart_version = "0.0.34"
hidden chart_source_url = "https://github.com/rancher/local-path-provisioner.git"
hidden chart_source_tag = "v0.0.34"

resources: Listing = new { 
  new Namespace {
    metadata {
      name = module.namespace
    }
  }
  new {
    apiVersion = "source.toolkit.fluxcd.io/v1"
    kind = "GitRepository"
    metadata {
      name = helm_chart_name
      namespace = "flux-system"
    }
    spec {
      interval = "10m"
      url = chart_source_url
      ref {
        tag = chart_source_tag
      }
    }
  }
  new {
    apiVersion = "helm.toolkit.fluxcd.io/v2"
    kind = "HelmRelease"
    metadata {
      name = helm_chart_name
      namespace = module.namespace
    }
    spec {
      interval = "10m"
      chart {
        spec {
          chart = "./deploy/chart/local-path-provisioner"
          sourceRef {
            kind = "GitRepository"
            name = helm_chart_name
            namespace = "flux-system"
          }
          interval = "10m"
        }
      }
      values {
        storageClass {
          defaultClass = true
        }
        nodePathMap {
          new {
            node = "DEFAULT_PATH_FOR_NON_LISTED_NODES"
            paths {
              "/var/opt/local-path-provisioner"
            }
          }
        }
      }
    }
  }
}

output {
  value = resources
  renderer = (K8sResource.output.renderer as YamlRenderer) {
    isStream = true
  }
  files {
    ["local-path-provisioner.yaml"] {
      value = resources
      renderer = (K8sResource.output.renderer as YamlRenderer) {
        isStream = true
      }
    }
  }
}